{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSNSTransactionalPatientSMS",
      "Effect": "Allow",
      "Action": [
        "sns:Publish"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowS3DailyDoHAuditLogs",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::sizacloud-doh-audit-logs-af-south-1",
        "arn:aws:s3:::sizacloud-doh-audit-logs-af-south-1/*"
      ]
    },
    {
      "Sid": "AllowCloudWatchCustomMetrics",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricData"
      ],
      "Resource": "*"
    }
  ]
}